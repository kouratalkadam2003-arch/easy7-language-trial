   "kind": "learning",
   "isLearningInput": true,
   "purposeArabic": "تحديد أولوية وتبريرها.",
   "lines": [
    {
     "lineId": "L_B2_FR_D03_01",
     "speakerId": "elly",
     "targetText": "L’équipe est préoccupée par la priorité du projet.",
     "englishReference": "The team has concerns about the project priority.",
     "arabicTranslation": "لنناقش هذا الأمر بوضوح.",
     "pronunciation": "L’équipe est préoccupée par la priorité du projet.",
     "phraseIds": [
      "P_B2_FR_D03_S01"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B2_FR_D03_02",
     "speakerId": "laith",
     "targetText": "Ma position est que l’eau propre doit primer.",
     "englishReference": "My position is that clean water should come first.",
     "arabicTranslation": "موقفي هو أن الخيار يحتاج توازنًا.",
     "pronunciation": "Ma position est que l’eau propre doit primer.",
     "phraseIds": [
      "P_B2_FR_D03_C01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_FR_D03_03",
     "speakerId": "elly",
     "targetText": "Pouvez-vous expliquer le risque ?",
     "englishReference": "Can you explain the risk?",
     "arabicTranslation": "ما الاعتراض الأقوى؟",
     "pronunciation": "Pouvez-vous expliquer le risque ?",
     "phraseIds": [
      "P_B2_FR_D03_I01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_FR_D03_04",
     "speakerId": "laith",
     "targetText": "Le risque est que chaque projet est important.",
     "englishReference": "The risk is that every project is important.",
     "arabicTranslation": "لأن علينا النظر إلى النتائج الواقعية.",
     "pronunciation": "Le risque est que chaque projet est important.",
     "phraseIds": [
      "P_B2_FR_D03_C02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_FR_D03_05",
     "speakerId": "elly",
     "targetText": "Comment pouvons-nous le réduire ?",
     "englishReference": "How can we reduce it?",
     "arabicTranslation": "ماذا تقترح؟",
     "pronunciation": "Comment pouvons-nous le réduire ?",
     "phraseIds": [
      "P_B2_FR_D03_I02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_FR_D03_06",
     "speakerId": "laith",
     "targetText": "Nous pouvons agir si nous pouvons préparer le terrain pour les autres.",
     "englishReference": "We can act if we can set stages for the others.",
     "arabicTranslation": "يمكننا وضع شرط عادل وواضح.",
     "pronunciation": "Nous pouvons agir si nous pouvons préparer le terrain pour les autres.",
     "phraseIds": [
      "P_B2_FR_D03_C03"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_FR_D03_07",
     "speakerId": "elly",
     "targetText": "C'est une condition utile.",
     "englishReference": "That is a useful condition.",
     "arabicTranslation": "هذا يبدو متوازنًا.",
     "pronunciation": "C'est une condition utile.",
     "phraseIds": [
      "P_B2_FR_D03_S02"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B2_FR_D03_08",
     "speakerId": "laith",
     "targetText": "Merci. Je le partagerai avec l'équipe.",
     "englishReference": "Thank you. I will share it with the team.",

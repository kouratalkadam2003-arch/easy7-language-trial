  {
   "sceneId": "SC_B2_D08_LEARN",
   "kind": "learning",
   "isLearningInput": true,
   "purposeArabic": "تقديم تنازل دون التخلي عن الهدف.",
   "lines": [
    {
     "lineId": "L_B2_FR_D08_01",
     "speakerId": "gaston",
     "targetText": "Nous devons revoir la date de livraison.",
     "englishReference": "We need to review the delivery date.",
     "arabicTranslation": "لنناقش هذا الأمر بوضوح.",
     "pronunciation": "Nous devons revoir la date de livraison.",
     "phraseIds": [
      "P_B2_FR_D08_S01"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B2_FR_D08_02",
     "speakerId": "laith",
     "targetText": "Par rapport à l’autre option, nous pouvons décaler la livraison d’un jour.",
     "englishReference": "Compared with the other option, we can move the delivery by one day.",
     "arabicTranslation": "موقفي هو أن الخيار يحتاج توازنًا.",
     "pronunciation": "Par rapport à l’autre option, nous pouvons décaler la livraison d’un jour.",
     "phraseIds": [
      "P_B2_FR_D08_C01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_FR_D08_03",
     "speakerId": "gaston",
     "targetText": "Pourquoi est-ce important ?",
     "englishReference": "Why is that important?",
     "arabicTranslation": "ما الاعتراض الأقوى؟",
     "pronunciation": "Pourquoi est-ce important ?",
     "phraseIds": [
      "P_B2_FR_D08_I01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_FR_D08_04",
     "speakerId": "laith",
     "targetText": "Parce que la date originale est difficile.",
     "englishReference": "Because the original date is difficult.",
     "arabicTranslation": "لأن علينا النظر إلى النتائج الواقعية.",
     "pronunciation": "Parce que la date originale est difficile.",
     "phraseIds": [
      "P_B2_FR_D08_C02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_FR_D08_05",
     "speakerId": "gaston",
     "targetText": "Que devrait-il se passer ensuite ?",
     "englishReference": "What should happen next?",
     "arabicTranslation": "ماذا تقترح؟",
     "pronunciation": "Que devrait-il se passer ensuite ?",
     "phraseIds": [
      "P_B2_FR_D08_I02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_FR_D08_06",
     "speakerId": "laith",
     "targetText": "Je suggère que nous puissions garantir des produits frais.",
     "englishReference": "I suggest that we can guarantee fresh products.",
     "arabicTranslation": "يمكننا وضع شرط عادل وواضح.",
     "pronunciation": "Je suggère que nous puissions garantir des produits frais.",
     "phraseIds": [
      "P_B2_FR_D08_C03"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_FR_D08_07",
     "speakerId": "gaston",
     "targetText": "Je comprends votre position.",
     "englishReference": "I understand your position.",
     "arabicTranslation": "هذا يبدو متوازنًا.",
     "pronunciation": "Je comprends votre position.",
     "phraseIds": [
      "P_B2_FR_D08_S02"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B2_FR_D08_08",

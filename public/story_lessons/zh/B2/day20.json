  },
  {
   "sceneId": "SC_B2_D20_LEARN",
   "kind": "learning",
   "isLearningInput": true,
   "purposeArabic": "دمج قيادة فريق وتفاوض وعرض.",
   "lines": [
    {
     "lineId": "L_B2_ZH_D20_01",
     "speakerId": "team",
     "targetText": "我们需要重新审视合作使命。",
     "englishReference": "We need to review the cooperation mission.",
     "arabicTranslation": "لنناقش هذا الأمر بوضوح.",
     "pronunciation": "wǒ men xū yào chóng xīn shěn shì hé zuò shǐ mìng.",
     "phraseIds": [
      "P_B2_ZH_D20_S01"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B2_ZH_D20_02",
     "speakerId": "laith",
     "targetText": "与其他选择相比，我们可以负责任地继续下去。",
     "englishReference": "Compared with the other option, we can continue responsibly.",
     "arabicTranslation": "موقفي هو أن الخيار يحتاج توازنًا.",
     "pronunciation": "yǔ qí tā xuǎn zé xiāng bǐ, wǒ men kě yǐ fù zé rèn dì jì xù xià qù.",
     "phraseIds": [
      "P_B2_ZH_D20_C01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_ZH_D20_03",
     "speakerId": "team",
     "targetText": "为什么这很重要？",
     "englishReference": "Why is that important?",
     "arabicTranslation": "ما الاعتراض الأقوى؟",
     "pronunciation": "wèi shén me zhè hěn zhòng yào.",
     "phraseIds": [
      "P_B2_ZH_D20_I01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_ZH_D20_04",
     "speakerId": "laith",
     "targetText": "因为结果令人鼓舞。",
     "englishReference": "Because the result is encouraging.",
     "arabicTranslation": "لأن علينا النظر إلى النتائج الواقعية.",
     "pronunciation": "yīn wèi jié guǒ lìng rén gǔ wǔ.",
     "phraseIds": [
      "P_B2_ZH_D20_C02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_ZH_D20_05",
     "speakerId": "team",
     "targetText": "接下来会发生什么？",
     "englishReference": "What should happen next?",
     "arabicTranslation": "ماذا تقترح؟",
     "pronunciation": "jiē xià lái huì fā shēng shén me.",
     "phraseIds": [
      "P_B2_ZH_D20_I02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_ZH_D20_06",
     "speakerId": "laith",
     "targetText": "我建议我们可以悄悄调查一下记录。",
     "englishReference": "I suggest that we can investigate the record quietly.",
     "arabicTranslation": "يمكننا وضع شرط عادل وواضح.",
     "pronunciation": "wǒ jiàn yì wǒ men kě yǐ qiāo qiāo diào chá yī xià jì lù.",
     "phraseIds": [
      "P_B2_ZH_D20_C03"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_ZH_D20_07",
     "speakerId": "team",
     "targetText": "我理解你的立场。",
     "englishReference": "I understand your position.",
     "arabicTranslation": "هذا يبدو متوازنًا.",
     "pronunciation": "wǒ lǐ jiě nǐ de lì chǎng.",
     "phraseIds": [
      "P_B2_ZH_D20_S02"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B2_ZH_D20_08",
     "speakerId": "laith",
     "targetText": "好的。我们可以继续小心。",
     "englishReference": "Good. We can continue carefully.",
     "arabicTranslation": "شكرًا، لنكتب الخطوة التالية.",
     "pronunciation": "hǎo de. wǒ men kě yǐ jì xù xiǎo xīn.",
     "phraseIds": [
      "P_B2_ZH_D20_S03"
     ],
     "teachingExposure": "context"
    }
   ]

   "lines": [
    {
     "lineId": "L_A2_ZH_D15_01",
     "speakerId": "noor",
     "targetText": "早上好，莱斯。我是市场团队的新手。",
     "englishReference": "Good morning, Laith. I am new to the market team.",
     "arabicTranslation": "صباح الخير يا ليث. I am new to the market team.",
     "pronunciation": "zǎo shàng hǎo, lái sī. wǒ shì shì chǎng tuán duì de xīn shǒu.",
     "phraseIds": [
      "P_A2_ZH_D15_S01"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_A2_ZH_D15_02",
     "speakerId": "laith",
     "targetText": "早上好。欢迎。我们每天早上都一起工作。",
     "englishReference": "Good morning. Welcome. We work together every morning.",
     "arabicTranslation": "صباح الخير. Welcome. We work together every morning.",
     "pronunciation": "zǎo shàng hǎo. huān yíng. wǒ men měi tiān zǎo shàng dōu yì qǐ gōng zuò.",
     "phraseIds": [
      "P_A2_ZH_D15_C01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_A2_ZH_D15_03",
     "speakerId": "noor",
     "targetText": "我今天的工作是什么？",
     "englishReference": "What is my job today?",
     "arabicTranslation": "What is my job today?",
     "pronunciation": "wǒ jīn tiān de gōng zuò shì shén me.",
     "phraseIds": [
      "P_A2_ZH_D15_I01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_A2_ZH_D15_04",
     "speakerId": "laith",
     "targetText": "您可以按颜色排列蔬菜。",
     "englishReference": "You can arrange the vegetables by color.",
     "arabicTranslation": "You can arrange the vegetables by color.",
     "pronunciation": "nín kě yǐ àn yán sè pái liè shū cài.",
     "phraseIds": [
      "P_A2_ZH_D15_C02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_A2_ZH_D15_05",
     "speakerId": "noor",
     "targetText": "谁检查价格？",
     "englishReference": "Who checks the prices?",
     "arabicTranslation": "Who checks the prices?",
     "pronunciation": "shuí jiǎn chá jià gé.",
     "phraseIds": [
      "P_A2_ZH_D15_I02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_A2_ZH_D15_06",
     "speakerId": "laith",
     "targetText": "文森特通常会检查它们。",
     "englishReference": "Vincent usually checks them.",
     "arabicTranslation": "Vincent usually checks them.",
     "pronunciation": "wén sēn tè tōng cháng huì jiǎn chá tā men.",
     "phraseIds": [
      "P_A2_ZH_D15_C03"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_A2_ZH_D15_07",
     "speakerId": "noor",
     "targetText": "这听起来是个好计划。",
     "englishReference": "That sounds like a good plan.",
     "arabicTranslation": "تبدو هذه خطة جيدة.",
     "pronunciation": "zhè tīng qǐ lái shì gè hǎo jì huà.",
     "phraseIds": [
      "P_A2_ZH_D15_S02"
     ],
     "teachingExposure": "context"
    },
    {

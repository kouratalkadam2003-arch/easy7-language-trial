     "arabicTranslation": "شكرًا لك. أراك لاحقًا.",
     "pronunciation": "xiè xiè. shāo hòu jiàn.",
     "phraseIds": [
      "P_A2_ZH_D15_S03"
     ],
     "teachingExposure": "context"

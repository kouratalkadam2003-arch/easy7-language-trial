    },
    {
     "lineId": "L_A1_ZH_D27_05",
     "speakerId": "noor",
     "targetText": "每个地方有多少种子？",
     "englishReference": "How many seeds in each place?",
     "arabicTranslation": "كم بذرة في كل مكان؟",
     "pronunciation": "měi gè dì fāng yǒu duō shǎo zhǒng zi.",
     "gesture": {
      "kind": "none",

   "lines": [
    {
     "lineId": "L_A1_ZH_D06_01",
     "speakerId": "elias",
     "targetText": "你好，莱斯。你今天怎么样？",
     "englishReference": "Hello, Laith. How are you today?",
     "arabicTranslation": "مرحبًا يا ليث. كيف حالك اليوم؟",
     "pronunciation": "nǐ hǎo, lái sī. nǐ jīn tiān zěn me yàng.",
     "gesture": {
      "kind": "none",
      "instructionalRole": "none"
     },
     "phraseIds": [
      "P_A1_ZH_D06_S01"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_A1_ZH_D06_02",
     "speakerId": "laith",
     "targetText": "我今天好多了，谢谢。",
     "englishReference": "I am better today, thank you.",
     "arabicTranslation": "أنا أفضل اليوم، شكرًا لك.",
     "pronunciation": "wǒ jīn tiān hǎo duō le, xiè xiè.",
     "gesture": {
      "kind": "none",
      "instructionalRole": "none"
     },
     "phraseIds": [
      "P_A1_ZH_D06_I01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_A1_ZH_D06_03",
     "speakerId": "elias",
     "targetText": "那很好。你累了吗？",
     "englishReference": "That is good. Are you tired?",
     "arabicTranslation": "هذا جيد. هل أنت متعب؟",
     "pronunciation": "nà hěn hǎo. nǐ lèi le ma.",
     "gesture": {
      "kind": "none",
      "instructionalRole": "none"
     },
     "phraseIds": [
      "P_A1_ZH_D06_C01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_A1_ZH_D06_04",
     "speakerId": "laith",
     "targetText": "有点累，但是很开心。",
     "englishReference": "A little tired, but happy.",
     "arabicTranslation": "متعب قليلًا، لكنني سعيد.",
     "pronunciation": "yǒu diǎn lèi, dàn shì hěn kāi xīn.",
     "gesture": {
      "kind": "none",
      "instructionalRole": "none"
     },
     "phraseIds": [
      "P_A1_ZH_D06_S02"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_A1_ZH_D06_05",
     "speakerId": "elias",
     "targetText": "我很高兴听到这个消息。",
     "englishReference": "I am glad to hear that.",
     "arabicTranslation": "يسعدني سماع ذلك.",
     "pronunciation": "wǒ hěn gāo xìng tīng dào zhè ge xiāo xī.",
     "gesture": {
      "kind": "none",
      "instructionalRole": "none"
     },
     "phraseIds": [
      "P_A1_ZH_D06_C02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_A1_ZH_D06_06",
     "speakerId": "laith",
     "targetText": "你好吗，埃利亚斯？",
     "englishReference": "And how are you, Elias?",
     "arabicTranslation": "وكيف حالك أنت يا إلياس؟",
     "pronunciation": "nǐ hǎo ma, āi lì yà sī.",
     "gesture": {
      "kind": "none",
      "instructionalRole": "none"
     },
     "phraseIds": [
      "P_A1_ZH_D06_C03"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_A1_ZH_D06_07",
     "speakerId": "elias",
     "targetText": "我很好谢谢。",
     "englishReference": "I am fine, thank you.",
     "arabicTranslation": "أنا بخير، شكرًا لك.",
     "pronunciation": "wǒ hěn hǎo xiè xiè.",
     "gesture": {
      "kind": "none",
      "instructionalRole": "none"
     },
     "phraseIds": [
      "P_A1_ZH_D06_S03"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_A1_ZH_D06_08",
     "speakerId": "laith",
     "targetText": "再见，埃利亚斯。明天见。",
     "englishReference": "Goodbye, Elias. See you tomorrow.",
     "arabicTranslation": "وداعًا يا إلياس. أراك غدًا.",
     "pronunciation": "zài jiàn, āi lì yà sī. míng tiān jiàn.",

  },
  {
   "sceneId": "SC_B1_D12_LEARN",
   "kind": "learning",
   "isLearningInput": true,
   "purposeArabic": "توزيع مهام وتأكيد فهم الخطة.",
   "lines": [
    {
     "lineId": "L_B1_ZH_D12_01",
     "speakerId": "team",
     "targetText": "我们需要谈谈修复任务。",
     "englishReference": "We need to talk about the repair tasks.",
     "arabicTranslation": "نحتاج إلى الحديث عن the repair tasks.",
     "pronunciation": "wǒ men xū yào tán tán xiū fù rèn wù.",
     "phraseIds": [
      "P_B1_ZH_D12_S01"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B1_ZH_D12_02",
     "speakerId": "laith",
     "targetText": "在我看来，每个人都需要一项明确的任务。",
     "englishReference": "In my opinion, each person needs one clear task.",
     "arabicTranslation": "في رأيي، each person needs one clear task.",
     "pronunciation": "zài wǒ kàn lái, měi gè rén dōu xū yào yī xiàng míng què de rèn wù.",
     "phraseIds": [
      "P_B1_ZH_D12_C01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_ZH_D12_03",
     "speakerId": "team",
     "targetText": "你为什么这么认为？",
     "englishReference": "Why do you think that?",
     "arabicTranslation": "لماذا تعتقد ذلك؟",
     "pronunciation": "nǐ wèi shén me zhè me rèn wéi.",
     "phraseIds": [
      "P_B1_ZH_D12_I01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_ZH_D12_04",
     "speakerId": "laith",
     "targetText": "因为明确的角色可以防止混乱。",
     "englishReference": "Because clear roles prevent confusion.",
     "arabicTranslation": "لأن clear roles prevent confusion.",
     "pronunciation": "yīn wèi míng què de jué sè kě yǐ fáng zhǐ hùn luàn.",
     "phraseIds": [
      "P_B1_ZH_D12_C02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_ZH_D12_05",
     "speakerId": "team",
     "targetText": "我们首先应该做什么？",
     "englishReference": "What should we do first?",
     "arabicTranslation": "ماذا ينبغي أن نفعل أولًا؟",
     "pronunciation": "wǒ men shǒu xiān yīng gāi zuò shén me.",
     "phraseIds": [
      "P_B1_ZH_D12_I02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_ZH_D12_06",
     "speakerId": "laith",
     "targetText": "我建议我们中午检查一下进度。",
     "englishReference": "I suggest that we should check progress at noon.",
     "arabicTranslation": "أقترح أن we should check progress at noon.",
     "pronunciation": "wǒ jiàn yì wǒ men zhōng wǔ jiǎn chá yī xià jìn dù.",
     "phraseIds": [
      "P_B1_ZH_D12_C03"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_ZH_D12_07",
     "speakerId": "team",
     "targetText": "这似乎很合理。",
     "englishReference": "That seems reasonable.",
     "arabicTranslation": "يبدو ذلك معقولًا.",
     "pronunciation": "zhè sì hū hěn hé lǐ.",
     "phraseIds": [
      "P_B1_ZH_D12_S02"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B1_ZH_D12_08",
     "speakerId": "laith",
     "targetText": "谢谢。我会向团队解释。",
     "englishReference": "Thank you. I will explain it to the team.",
     "arabicTranslation": "شكرًا. سأشرحه للفريق.",
     "pronunciation": "xiè xiè. wǒ huì xiàng tuán duì jiě shì.",
     "phraseIds": [
      "P_B1_ZH_D12_S03"
     ],
     "teachingExposure": "context"
    }
   ]
  },

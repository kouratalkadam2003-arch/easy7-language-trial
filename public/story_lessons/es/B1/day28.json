  {
   "sceneId": "SC_B1_D28_LEARN",
   "kind": "learning",
   "isLearningInput": true,
   "purposeArabic": "تقييم تعاون الفريق وتحسينه.",
   "lines": [
    {
     "lineId": "L_B1_ES_D28_01",
     "speakerId": "team",
     "targetText": "Necesitamos hablar del equipo visitante.",
     "englishReference": "We need to talk about the road team.",
     "arabicTranslation": "نحتاج إلى الحديث عن the road team.",
     "pronunciation": "Necesitamos hablar del equipo visitante.",
     "phraseIds": [
      "P_B1_ES_D28_S01"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B1_ES_D28_02",
     "speakerId": "laith",
     "targetText": "En mi opinión, trabajamos mejor cuando compartimos inquietudes.",
     "englishReference": "In my opinion, we work better when we share concerns.",
     "arabicTranslation": "في رأيي، we work better when we share concerns.",
     "pronunciation": "En mi opinión, trabajamos mejor cuando compartimos inquietudes.",
     "phraseIds": [
      "P_B1_ES_D28_C01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_ES_D28_03",
     "speakerId": "team",
     "targetText": "¿Por qué piensas eso?",
     "englishReference": "Why do you think that?",
     "arabicTranslation": "لماذا تعتقد ذلك؟",
     "pronunciation": "¿Por qué piensas eso?",
     "phraseIds": [
      "P_B1_ES_D28_I01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_ES_D28_04",
     "speakerId": "laith",
     "targetText": "Porque la confianza necesita una comunicación honesta.",
     "englishReference": "Because trust needs honest communication.",
     "arabicTranslation": "لأن trust needs honest communication.",
     "pronunciation": "Porque la confianza necesita una comunicación honesta.",
     "phraseIds": [
      "P_B1_ES_D28_C02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_ES_D28_05",
     "speakerId": "team",
     "targetText": "¿Qué debemos hacer primero?",
     "englishReference": "What should we do first?",
     "arabicTranslation": "ماذا ينبغي أن نفعل أولًا؟",
     "pronunciation": "¿Qué debemos hacer primero?",
     "phraseIds": [
      "P_B1_ES_D28_I02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_ES_D28_06",
     "speakerId": "laith",
     "targetText": "Sugiero que nos apoyemos unos a otros.",
     "englishReference": "I suggest that we should support each other.",
     "arabicTranslation": "أقترح أن we should support each other.",
     "pronunciation": "Sugiero que nos apoyemos unos a otros.",
     "phraseIds": [
      "P_B1_ES_D28_C03"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_ES_D28_07",
     "speakerId": "team",
     "targetText": "Eso parece razonable.",
     "englishReference": "That seems reasonable.",
     "arabicTranslation": "يبدو ذلك معقولًا.",
     "pronunciation": "Eso parece razonable.",
     "phraseIds": [
      "P_B1_ES_D28_S02"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B1_ES_D28_08",
     "speakerId": "laith",
     "targetText": "Gracias. Se lo explicaré al equipo.",
     "englishReference": "Thank you. I will explain it to the team.",
     "arabicTranslation": "شكرًا. سأشرحه للفريق.",
     "pronunciation": "Gracias. Se lo explicaré al equipo.",
     "phraseIds": [
      "P_B1_ES_D28_S03"
     ],

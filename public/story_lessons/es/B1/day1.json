  {
   "sceneId": "SC_B1_D01_LEARN",
   "kind": "learning",
   "isLearningInput": true,
   "purposeArabic": "إبداء رأي مع سبب عن مشكلة مشتركة.",
   "lines": [
    {
     "lineId": "L_B1_ES_D01_01",
     "speakerId": "elly",
     "targetText": "Necesitamos hablar sobre el horario del agua.",
     "englishReference": "We need to talk about the water schedule.",
     "arabicTranslation": "نحتاج إلى الحديث عن the water schedule.",
     "pronunciation": "Necesitamos hablar sobre el horario del agua.",
     "phraseIds": [
      "P_B1_ES_D01_S01"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B1_ES_D01_02",
     "speakerId": "laith",
     "targetText": "En mi opinión, necesitamos un calendario justo.",
     "englishReference": "In my opinion, we need a fair schedule.",
     "arabicTranslation": "في رأيي، we need a fair schedule.",
     "pronunciation": "En mi opinión, necesitamos un calendario justo.",
     "phraseIds": [
      "P_B1_ES_D01_C01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_ES_D01_03",
     "speakerId": "elly",
     "targetText": "¿Por qué piensas eso?",
     "englishReference": "Why do you think that?",
     "arabicTranslation": "لماذا تعتقد ذلك؟",
     "pronunciation": "¿Por qué piensas eso?",
     "phraseIds": [
      "P_B1_ES_D01_I01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_ES_D01_04",
     "speakerId": "laith",
     "targetText": "Porque todo jardín necesita agua.",
     "englishReference": "Because every garden needs water.",
     "arabicTranslation": "لأن every garden needs water.",
     "pronunciation": "Porque todo jardín necesita agua.",
     "phraseIds": [
      "P_B1_ES_D01_C02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_ES_D01_05",
     "speakerId": "elly",
     "targetText": "¿Qué debemos hacer primero?",
     "englishReference": "What should we do first?",
     "arabicTranslation": "ماذا ينبغي أن نفعل أولًا؟",
     "pronunciation": "¿Qué debemos hacer primero?",
     "phraseIds": [
      "P_B1_ES_D01_I02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_ES_D01_06",
     "speakerId": "laith",
     "targetText": "Sugiero que escuchemos a todas las familias.",
     "englishReference": "I suggest that we should listen to every family.",
     "arabicTranslation": "أقترح أن we should listen to every family.",
     "pronunciation": "Sugiero que escuchemos a todas las familias.",
     "phraseIds": [
      "P_B1_ES_D01_C03"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_ES_D01_07",
     "speakerId": "elly",
     "targetText": "Eso parece razonable.",
     "englishReference": "That seems reasonable.",
     "arabicTranslation": "يبدو ذلك معقولًا.",
     "pronunciation": "Eso parece razonable.",
     "phraseIds": [
      "P_B1_ES_D01_S02"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B1_ES_D01_08",
     "speakerId": "laith",
     "targetText": "Gracias. Se lo explicaré al equipo.",
     "englishReference": "Thank you. I will explain it to the team.",
     "arabicTranslation": "شكرًا. سأشرحه للفريق.",
     "pronunciation": "Gracias. Se lo explicaré al equipo.",

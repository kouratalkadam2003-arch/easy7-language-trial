     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_EN_D24_04",
     "speakerId": "laith",
     "targetText": "Because official requests need details.",
     "englishReference": "Because official requests need details.",
     "arabicTranslation": "لأن official requests need details.",
     "pronunciation": "Because official requests need details.",
     "phraseIds": [
      "P_B1_EN_D24_C02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_EN_D24_05",
     "speakerId": "gaston",
     "targetText": "What should we do first?",
     "englishReference": "What should we do first?",
     "arabicTranslation": "ماذا ينبغي أن نفعل أولًا؟",
     "pronunciation": "What should we do first?",
     "phraseIds": [
      "P_B1_EN_D24_I02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_EN_D24_06",
     "speakerId": "laith",
     "targetText": "I suggest that we should include the project dates.",
     "englishReference": "I suggest that we should include the project dates.",
     "arabicTranslation": "أقترح أن we should include the project dates.",
     "pronunciation": "I suggest that we should include the project dates.",
     "phraseIds": [
      "P_B1_EN_D24_C03"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_EN_D24_07",
     "speakerId": "gaston",
     "targetText": "That seems reasonable.",
     "englishReference": "That seems reasonable.",
     "arabicTranslation": "يبدو ذلك معقولًا.",

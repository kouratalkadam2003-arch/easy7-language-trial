     "lineId": "L_B1_EN_D24_01",
     "speakerId": "gaston",
     "targetText": "We need to talk about the support letter.",
     "englishReference": "We need to talk about the support letter.",
     "arabicTranslation": "نحتاج إلى الحديث عن the support letter.",
     "pronunciation": "We need to talk about the support letter.",

      "P_B1_EN_D24_S01"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B1_EN_D24_02",
     "speakerId": "laith",
     "targetText": "In my opinion, the letter should be clear and polite.",
     "englishReference": "In my opinion, the letter should be clear and polite.",
     "arabicTranslation": "في رأيي، the letter should be clear and polite.",
     "pronunciation": "In my opinion, the letter should be clear and polite.",
     "phraseIds": [
      "P_B1_EN_D24_C01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_EN_D24_03",
     "speakerId": "gaston",
     "targetText": "Why do you think that?",
     "englishReference": "Why do you think that?",
     "arabicTranslation": "لماذا تعتقد ذلك؟",

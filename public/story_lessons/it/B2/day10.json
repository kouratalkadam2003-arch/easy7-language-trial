   "purposeArabic": "التفاوض حول قيمة وخدمة.",
   "lines": [
    {
     "lineId": "L_B2_IT_D10_01",
     "speakerId": "noor",
     "targetText": "Prima di decidere, in che modo i costi di riparazione influiscono su entrambe le parti?",
     "englishReference": "Before we decide, how does the repair cost affect both sides?",
     "arabicTranslation": "لنناقش هذا الأمر بوضوح.",
     "pronunciation": "Prima di decidere, in che modo i costi di riparazione influiscono su entrambe le parti?",
     "phraseIds": [
      "P_B2_IT_D10_S01"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B2_IT_D10_02",
     "speakerId": "laith",
     "targetText": "Penso che il prezzo rifletta il lavoro reale.",
     "englishReference": "I think the price reflects real work.",
     "arabicTranslation": "موقفي هو أن الخيار يحتاج توازنًا.",
     "pronunciation": "Penso che il prezzo rifletta il lavoro reale.",
     "phraseIds": [
      "P_B2_IT_D10_C01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_IT_D10_03",
     "speakerId": "noor",
     "targetText": "Qual è l'obiezione più forte?",
     "englishReference": "What is the strongest objection?",
     "arabicTranslation": "ما الاعتراض الأقوى؟",
     "pronunciation": "Qual è l'obiezione più forte?",
     "phraseIds": [
      "P_B2_IT_D10_I01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_IT_D10_04",
     "speakerId": "laith",
     "targetText": "Sebbene il budget sia limitato, possiamo migliorare il piano.",
     "englishReference": "Although the budget is limited, we can improve the plan.",
     "arabicTranslation": "لأن علينا النظر إلى النتائج الواقعية.",
     "pronunciation": "Sebbene il budget sia limitato, possiamo migliorare il piano.",
     "phraseIds": [
      "P_B2_IT_D10_C02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_IT_D10_05",
     "speakerId": "noor",
     "targetText": "Cosa sei disposto ad offrire?",
     "englishReference": "What are you willing to offer?",
     "arabicTranslation": "ماذا تقترح؟",
     "pronunciation": "Cosa sei disposto ad offrire?",
     "phraseIds": [
      "P_B2_IT_D10_I02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_IT_D10_06",
     "speakerId": "laith",
     "targetText": "Se siamo d'accordo, possiamo dividere equamente i costi.",
     "englishReference": "If we agree, we can divide the cost fairly.",
     "arabicTranslation": "يمكننا وضع شرط عادل وواضح.",
     "pronunciation": "Se siamo d'accordo, possiamo dividere equamente i costi.",
     "phraseIds": [
      "P_B2_IT_D10_C03"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_IT_D10_07",
     "speakerId": "noor",
     "targetText": "Sembra equilibrato.",
     "englishReference": "That sounds balanced.",
     "arabicTranslation": "هذا يبدو متوازنًا.",
     "pronunciation": "Sembra equilibrato.",
     "phraseIds": [

  {
   "sceneId": "SC_B2_D09_LEARN",
   "kind": "learning",
   "isLearningInput": true,
   "purposeArabic": "ذكر ضمان وشرط لرفع الثقة.",
   "lines": [
    {
     "lineId": "L_B2_IT_D09_01",
     "speakerId": "visitor",
     "targetText": "Il team è preoccupato per la garanzia di qualità.",
     "englishReference": "The team has concerns about the quality guarantee.",
     "arabicTranslation": "لنناقش هذا الأمر بوضوح.",
     "pronunciation": "Il team è preoccupato per la garanzia di qualità.",
     "phraseIds": [
      "P_B2_IT_D09_S01"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B2_IT_D09_02",
     "speakerId": "laith",
     "targetText": "La mia posizione è che controlleremo ogni consegna.",
     "englishReference": "My position is that we will check every delivery.",
     "arabicTranslation": "موقفي هو أن الخيار يحتاج توازنًا.",
     "pronunciation": "La mia posizione è che controlleremo ogni consegna.",
     "phraseIds": [
      "P_B2_IT_D09_C01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_IT_D09_03",
     "speakerId": "visitor",
     "targetText": "Puoi spiegare il rischio?",
     "englishReference": "Can you explain the risk?",
     "arabicTranslation": "ما الاعتراض الأقوى؟",
     "pronunciation": "Puoi spiegare il rischio?",
     "phraseIds": [
      "P_B2_IT_D09_I01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_IT_D09_04",
     "speakerId": "laith",
     "targetText": "Il rischio è che possano verificarsi degli errori.",
     "englishReference": "The risk is that mistakes can happen.",
     "arabicTranslation": "لأن علينا النظر إلى النتائج الواقعية.",
     "pronunciation": "Il rischio è che possano verificarsi degli errori.",
     "phraseIds": [
      "P_B2_IT_D09_C02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_IT_D09_05",
     "speakerId": "visitor",
     "targetText": "Come possiamo ridurlo?",
     "englishReference": "How can we reduce it?",
     "arabicTranslation": "ماذا تقترح؟",
     "pronunciation": "Come possiamo ridurlo?",
     "phraseIds": [
      "P_B2_IT_D09_I02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_IT_D09_06",
     "speakerId": "laith",
     "targetText": "Possiamo agire se riusciamo a sostituire rapidamente i prodotti danneggiati.",
     "englishReference": "We can act if we can replace damaged products quickly.",
     "arabicTranslation": "يمكننا وضع شرط عادل وواضح.",
     "pronunciation": "Possiamo agire se riusciamo a sostituire rapidamente i prodotti danneggiati.",
     "phraseIds": [
      "P_B2_IT_D09_C03"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_IT_D09_07",
     "speakerId": "visitor",
     "targetText": "Questa è una condizione utile.",
     "englishReference": "That is a useful condition.",
     "arabicTranslation": "هذا يبدو متوازنًا.",
     "pronunciation": "Questa è una condizione utile.",
     "phraseIds": [
      "P_B2_IT_D09_S02"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B2_IT_D09_08",
     "speakerId": "laith",
     "targetText": "Grazie. Lo condividerò con la squadra.",
     "englishReference": "Thank you. I will share it with the team.",
     "arabicTranslation": "شكرًا، لنكتب الخطوة التالية.",
     "pronunciation": "Grazie. Lo condividerò con la squadra.",
     "phraseIds": [

  },
  {
   "sceneId": "SC_B1_D19_LEARN",
   "kind": "learning",
   "isLearningInput": true,
   "purposeArabic": "اقتراح حل وسط بين طرفين.",
   "lines": [
    {
     "lineId": "L_B1_IT_D19_01",
     "speakerId": "elly",
     "targetText": "Dobbiamo parlare del conflitto temporale.",
     "englishReference": "We need to talk about the timing conflict.",
     "arabicTranslation": "نحتاج إلى الحديث عن the timing conflict.",
     "pronunciation": "Dobbiamo parlare del conflitto temporale.",
     "phraseIds": [
      "P_B1_IT_D19_S01"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B1_IT_D19_02",
     "speakerId": "laith",
     "targetText": "Secondo me, entrambe le esigenze sono importanti.",
     "englishReference": "In my opinion, both needs are important.",
     "arabicTranslation": "في رأيي، both needs are important.",
     "pronunciation": "Secondo me, entrambe le esigenze sono importanti.",
     "phraseIds": [
      "P_B1_IT_D19_C01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_IT_D19_03",
     "speakerId": "elly",
     "targetText": "Perché lo pensi?",
     "englishReference": "Why do you think that?",
     "arabicTranslation": "لماذا تعتقد ذلك؟",
     "pronunciation": "Perché lo pensi?",
     "phraseIds": [
      "P_B1_IT_D19_I01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_IT_D19_04",
     "speakerId": "laith",
     "targetText": "Perché nessuna delle due parti dovrebbe perdere tutto.",
     "englishReference": "Because neither side should lose everything.",
     "arabicTranslation": "لأن neither side should lose everything.",
     "pronunciation": "Perché nessuna delle due parti dovrebbe perdere tutto.",
     "phraseIds": [
      "P_B1_IT_D19_C02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_IT_D19_05",
     "speakerId": "elly",
     "targetText": "Cosa dovremmo fare prima?",
     "englishReference": "What should we do first?",
     "arabicTranslation": "ماذا ينبغي أن نفعل أولًا؟",
     "pronunciation": "Cosa dovremmo fare prima?",
     "phraseIds": [
      "P_B1_IT_D19_I02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_IT_D19_06",
     "speakerId": "laith",
     "targetText": "Suggerisco di condividere le prime ore del mattino.",
     "englishReference": "I suggest that we should share the early hours.",
     "arabicTranslation": "أقترح أن we should share the early hours.",
     "pronunciation": "Suggerisco di condividere le prime ore del mattino.",
     "phraseIds": [
      "P_B1_IT_D19_C03"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_IT_D19_07",
     "speakerId": "elly",
     "targetText": "Sembra ragionevole.",
     "englishReference": "That seems reasonable.",
     "arabicTranslation": "يبدو ذلك معقولًا.",
     "pronunciation": "Sembra ragionevole.",
     "phraseIds": [
      "P_B1_IT_D19_S02"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B1_IT_D19_08",
     "speakerId": "laith",
     "targetText": "Grazie. Lo spiegherò alla squadra.",
     "englishReference": "Thank you. I will explain it to the team.",
     "arabicTranslation": "شكرًا. سأشرحه للفريق.",
     "pronunciation": "Grazie. Lo spiegherò alla squadra.",
     "phraseIds": [
      "P_B1_IT_D19_S03"
     ],

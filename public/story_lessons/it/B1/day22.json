  },
  {
   "sceneId": "SC_B1_D22_LEARN",
   "kind": "learning",
   "isLearningInput": true,
   "purposeArabic": "تقديم عرض مختصر منظم.",
   "lines": [
    {
     "lineId": "L_B1_IT_D22_01",
     "speakerId": "visitor",
     "targetText": "Dobbiamo parlare dei risultati dell'acqua.",
     "englishReference": "We need to talk about the water results.",
     "arabicTranslation": "نحتاج إلى الحديث عن the water results.",
     "pronunciation": "Dobbiamo parlare dei risultati dell'acqua.",
     "phraseIds": [
      "P_B1_IT_D22_S01"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B1_IT_D22_02",
     "speakerId": "laith",
     "targetText": "Secondo me, il nostro piano ha ridotto la confusione.",
     "englishReference": "In my opinion, our plan reduced confusion.",
     "arabicTranslation": "في رأيي، our plan reduced confusion.",
     "pronunciation": "Secondo me, il nostro piano ha ridotto la confusione.",
     "phraseIds": [
      "P_B1_IT_D22_C01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_IT_D22_03",
     "speakerId": "visitor",
     "targetText": "Perché lo pensi?",
     "englishReference": "Why do you think that?",
     "arabicTranslation": "لماذا تعتقد ذلك؟",
     "pronunciation": "Perché lo pensi?",
     "phraseIds": [
      "P_B1_IT_D22_I01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_IT_D22_04",
     "speakerId": "laith",
     "targetText": "Perché misuravamo il lavoro ogni giorno.",
     "englishReference": "Because we measured the work each day.",
     "arabicTranslation": "لأن we measured the work each day.",
     "pronunciation": "Perché misuravamo il lavoro ogni giorno.",
     "phraseIds": [
      "P_B1_IT_D22_C02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_IT_D22_05",
     "speakerId": "visitor",
     "targetText": "Cosa dovremmo fare prima?",
     "englishReference": "What should we do first?",
     "arabicTranslation": "ماذا ينبغي أن نفعل أولًا؟",
     "pronunciation": "Cosa dovremmo fare prima?",
     "phraseIds": [
      "P_B1_IT_D22_I02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_IT_D22_06",
     "speakerId": "laith",
     "targetText": "Suggerisco di condividere il metodo con voi.",
     "englishReference": "I suggest that we should share the method with you.",
     "arabicTranslation": "أقترح أن we should share the method with you.",
     "pronunciation": "Suggerisco di condividere il metodo con voi.",
     "phraseIds": [
      "P_B1_IT_D22_C03"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_IT_D22_07",
     "speakerId": "visitor",
     "targetText": "Sembra ragionevole.",
     "englishReference": "That seems reasonable.",
     "arabicTranslation": "يبدو ذلك معقولًا.",
     "pronunciation": "Sembra ragionevole.",
     "phraseIds": [
      "P_B1_IT_D22_S02"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B1_IT_D22_08",
     "speakerId": "laith",
     "targetText": "Grazie. Lo spiegherò alla squadra.",
     "englishReference": "Thank you. I will explain it to the team.",
     "arabicTranslation": "شكرًا. سأشرحه للفريق.",
     "pronunciation": "Grazie. Lo spiegherò alla squadra.",
     "phraseIds": [
      "P_B1_IT_D22_S03"
     ],
     "teachingExposure": "context"
    }

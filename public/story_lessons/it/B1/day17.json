   "purposeArabic": "التمييز بين دليل وتخمين.",
   "lines": [
    {
     "lineId": "L_B1_IT_D17_01",
     "speakerId": "elly",
     "targetText": "Dobbiamo parlare dei registri dell'acqua.",
     "englishReference": "We need to talk about the water records.",
     "arabicTranslation": "نحتاج إلى الحديث عن the water records.",
     "pronunciation": "Dobbiamo parlare dei registri dell'acqua.",
     "phraseIds": [
      "P_B1_IT_D17_S01"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B1_IT_D17_02",
     "speakerId": "laith",
     "targetText": "Secondo me i dati sono più utili delle supposizioni.",
     "englishReference": "In my opinion, the records are more useful than guesses.",
     "arabicTranslation": "في رأيي، the records are more useful than guesses.",
     "pronunciation": "Secondo me i dati sono più utili delle supposizioni.",
     "phraseIds": [
      "P_B1_IT_D17_C01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_IT_D17_03",
     "speakerId": "elly",
     "targetText": "Perché lo pensi?",
     "englishReference": "Why do you think that?",
     "arabicTranslation": "لماذا تعتقد ذلك؟",
     "pronunciation": "Perché lo pensi?",
     "phraseIds": [
      "P_B1_IT_D17_I01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_IT_D17_04",
     "speakerId": "laith",
     "targetText": "Perché mostrano cosa è realmente accaduto.",
     "englishReference": "Because they show what actually happened.",
     "arabicTranslation": "لأن they show what actually happened.",
     "pronunciation": "Perché mostrano cosa è realmente accaduto.",
     "phraseIds": [
      "P_B1_IT_D17_C02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_IT_D17_05",
     "speakerId": "elly",
     "targetText": "Cosa dovremmo fare prima?",
     "englishReference": "What should we do first?",

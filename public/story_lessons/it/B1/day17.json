     "pronunciation": "Cosa dovremmo fare prima?",
     "phraseIds": [
      "P_B1_IT_D17_I02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_IT_D17_06",
     "speakerId": "laith",
     "targetText": "Suggerisco di controllarli insieme.",
     "englishReference": "I suggest that we should check them together.",
     "arabicTranslation": "أقترح أن we should check them together.",
     "pronunciation": "Suggerisco di controllarli insieme.",
     "phraseIds": [
      "P_B1_IT_D17_C03"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_IT_D17_07",
     "speakerId": "elly",
     "targetText": "Sembra ragionevole.",
     "englishReference": "That seems reasonable.",
     "arabicTranslation": "يبدو ذلك معقولًا.",
     "pronunciation": "Sembra ragionevole.",
     "phraseIds": [
      "P_B1_IT_D17_S02"
     ],
     "teachingExposure": "context"

  {
   "sceneId": "SC_B1_D15_LEARN",
   "kind": "learning",
   "isLearningInput": true,
   "purposeArabic": "الاعتذار وشرح إصلاح خطأ.",
   "lines": [
    {
     "lineId": "L_B1_IT_D15_01",
     "speakerId": "martha",
     "targetText": "Dobbiamo parlare del messaggio mancato.",
     "englishReference": "We need to talk about the missed message.",
     "arabicTranslation": "نحتاج إلى الحديث عن the missed message.",
     "pronunciation": "Dobbiamo parlare del messaggio mancato.",
     "phraseIds": [
      "P_B1_IT_D15_S01"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B1_IT_D15_02",
     "speakerId": "laith",
     "targetText": "Secondo me mi dispiace di non avertelo detto.",
     "englishReference": "In my opinion, I am sorry I did not tell you.",
     "arabicTranslation": "في رأيي، I am sorry I did not tell you.",
     "pronunciation": "Secondo me mi dispiace di non avertelo detto.",
     "phraseIds": [
      "P_B1_IT_D15_C01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_IT_D15_03",
     "speakerId": "martha",
     "targetText": "Perché lo pensi?",
     "englishReference": "Why do you think that?",
     "arabicTranslation": "لماذا تعتقد ذلك؟",
     "pronunciation": "Perché lo pensi?",
     "phraseIds": [
      "P_B1_IT_D15_I01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_IT_D15_04",
     "speakerId": "laith",
     "targetText": "Perché il mio errore ha influenzato il tuo lavoro.",
     "englishReference": "Because my mistake affected your work.",
     "arabicTranslation": "لأن my mistake affected your work.",
     "pronunciation": "Perché il mio errore ha influenzato il tuo lavoro.",
     "phraseIds": [
      "P_B1_IT_D15_C02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_IT_D15_05",
     "speakerId": "martha",
     "targetText": "Cosa dovremmo fare prima?",
     "englishReference": "What should we do first?",
     "arabicTranslation": "ماذا ينبغي أن نفعل أولًا؟",
     "pronunciation": "Cosa dovremmo fare prima?",
     "phraseIds": [
      "P_B1_IT_D15_I02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_IT_D15_06",
     "speakerId": "laith",
     "targetText": "Suggerisco di informarti prima la prossima volta.",
     "englishReference": "I suggest that I will inform you earlier next time.",
     "arabicTranslation": "أقترح أن I will inform you earlier next time.",
     "pronunciation": "Suggerisco di informarti prima la prossima volta.",
     "phraseIds": [
      "P_B1_IT_D15_C03"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_IT_D15_07",
     "speakerId": "martha",
     "targetText": "Sembra ragionevole.",
     "englishReference": "That seems reasonable.",
     "arabicTranslation": "يبدو ذلك معقولًا.",
     "pronunciation": "Sembra ragionevole.",
     "phraseIds": [
      "P_B1_IT_D15_S02"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B1_IT_D15_08",

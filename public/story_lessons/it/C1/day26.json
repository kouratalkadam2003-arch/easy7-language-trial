  {
   "sceneId": "SC_C1_D26_LEARN",
   "kind": "learning",
   "isLearningInput": true,
   "purposeArabic": "موازنة مصلحة فرد ومجتمع.",
   "lines": [
    {
     "lineId": "L_C1_IT_D26_01",
     "speakerId": "elly",
     "targetText": "Dobbiamo esaminare attentamente l’interesse pubblico.",
     "englishReference": "We need to examine the public interest carefully.",
     "arabicTranslation": "يجب أن نحلل الموضوع بدقة.",
     "pronunciation": "Dobbiamo esaminare attentamente l’interesse pubblico.",
     "phraseIds": [
      "P_C1_IT_D26_S01"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_C1_IT_D26_02",
     "speakerId": "laith",
     "targetText": "La mia interpretazione è più complessa di quanto possa sembrare a prima vista.",
     "englishReference": "My interpretation is more complex than it first appears.",
     "arabicTranslation": "تفسيري أكثر تعقيدًا مما يبدو.",
     "pronunciation": "La mia interpretazione è più complessa di quanto possa sembrare a prima vista.",
     "phraseIds": [
      "P_C1_IT_D26_C01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_C1_IT_D26_03",
     "speakerId": "elly",
     "targetText": "Quali prove supportano questa visione?",
     "englishReference": "What evidence supports that view?",
     "arabicTranslation": "ما الدليل على ذلك؟",
     "pronunciation": "Quali prove supportano questa visione?",
     "phraseIds": [
      "P_C1_IT_D26_I01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_C1_IT_D26_04",
     "speakerId": "laith",
     "targetText": "Le prove sono utili, ma hanno dei limiti.",
     "englishReference": "The evidence is useful, but it has limits.",
     "arabicTranslation": "الدليل مفيد لكنه محدود.",
     "pronunciation": "Le prove sono utili, ma hanno dei limiti.",
     "phraseIds": [
      "P_C1_IT_D26_C02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_C1_IT_D26_05",
     "speakerId": "elly",
     "targetText": "Come dovremmo rispondere all’obiezione più forte?",
     "englishReference": "How should we respond to the strongest objection?",
     "arabicTranslation": "كيف نرد على الاعتراض الأقوى؟",
     "pronunciation": "Come dovremmo rispondere all’obiezione più forte?",
     "phraseIds": [
      "P_C1_IT_D26_I02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_C1_IT_D26_06",
     "speakerId": "laith",
     "targetText": "Dovremmo esporre chiaramente il nostro ragionamento e ammettere l’incertezza.",
     "englishReference": "We should state our reasoning clearly and admit uncertainty.",
     "arabicTranslation": "ينبغي أن نعرض استدلالنا بوضوح ونعترف بما لا نعرفه.",
     "pronunciation": "Dovremmo esporre chiaramente il nostro ragionamento e ammettere l’incertezza.",
     "phraseIds": [
      "P_C1_IT_D26_C03"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_C1_IT_D26_07",
     "speakerId": "elly",
     "targetText": "Questa è una posizione responsabile.",
     "englishReference": "That is a responsible position.",
     "arabicTranslation": "هذا موقف مسؤول.",
     "pronunciation": "Questa è una posizione responsabile.",
     "phraseIds": [
      "P_C1_IT_D26_S02"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_C1_IT_D26_08",
     "speakerId": "laith",
     "targetText": "Grazie. Continuiamo con cautela.",
     "englishReference": "Thank you. Let us continue with care.",
     "arabicTranslation": "شكرًا، لنتابع بحذر.",
     "pronunciation": "Grazie. Continuiamo con cautela.",
     "phraseIds": [
      "P_C1_IT_D26_S03"
     ],
     "teachingExposure": "context"
    }

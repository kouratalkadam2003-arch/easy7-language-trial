   "isLearningInput": true,
   "purposeArabic": "التعبير عن شك ودعم شخص متردد.",
   "lines": [
    {
     "lineId": "L_B2_DE_D26_01",
     "speakerId": "sara",
     "targetText": "Wir müssen Saras Bedenken überprüfen.",
     "englishReference": "We need to review Sara’s concern.",
     "arabicTranslation": "لنناقش هذا الأمر بوضوح.",
     "pronunciation": "Wir müssen Saras Bedenken überprüfen.",
     "phraseIds": [
      "P_B2_DE_D26_S01"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B2_DE_D26_02",
     "speakerId": "laith",
     "targetText": "Im Vergleich zur anderen Option haben Sie Recht, wenn Sie Fragen stellen.",
     "englishReference": "Compared with the other option, you are right to ask questions.",
     "arabicTranslation": "موقفي هو أن الخيار يحتاج توازنًا.",
     "pronunciation": "Im Vergleich zur anderen Option haben Sie Recht, wenn Sie Fragen stellen.",
     "phraseIds": [
      "P_B2_DE_D26_C01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_DE_D26_03",
     "speakerId": "sara",
     "targetText": "Warum ist das wichtig?",
     "englishReference": "Why is that important?",
     "arabicTranslation": "ما الاعتراض الأقوى؟",
     "pronunciation": "Warum ist das wichtig?",
     "phraseIds": [
      "P_B2_DE_D26_I01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_DE_D26_04",
     "speakerId": "laith",
     "targetText": "Denn Sie sollten sich dieser Situation nicht alleine stellen.",
     "englishReference": "Because you should not face this alone.",
     "arabicTranslation": "لأن علينا النظر إلى النتائج الواقعية.",
     "pronunciation": "Denn Sie sollten sich dieser Situation nicht alleine stellen.",
     "phraseIds": [
      "P_B2_DE_D26_C02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_DE_D26_05",
     "speakerId": "sara",
     "targetText": "Was soll als nächstes passieren?",
     "englishReference": "What should happen next?",
     "arabicTranslation": "ماذا تقترح؟",
     "pronunciation": "Was soll als nächstes passieren?",
     "phraseIds": [
      "P_B2_DE_D26_I02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_DE_D26_06",
     "speakerId": "laith",
     "targetText": "Ich schlage vor, dass wir gemeinsam nach Antworten suchen.",
     "englishReference": "I suggest that we can look for answers together.",
     "arabicTranslation": "يمكننا وضع شرط عادل وواضح.",
     "pronunciation": "Ich schlage vor, dass wir gemeinsam nach Antworten suchen.",
     "phraseIds": [
      "P_B2_DE_D26_C03"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_DE_D26_07",
     "speakerId": "sara",
     "targetText": "Ich verstehe Ihre Position.",
     "englishReference": "I understand your position.",
     "arabicTranslation": "هذا يبدو متوازنًا.",
     "pronunciation": "Ich verstehe Ihre Position.",
     "phraseIds": [
      "P_B2_DE_D26_S02"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B2_DE_D26_08",
     "speakerId": "laith",
     "targetText": "Gut. Wir können behutsam weitermachen.",
     "englishReference": "Good. We can continue carefully.",
     "arabicTranslation": "شكرًا، لنكتب الخطوة التالية.",
     "pronunciation": "Gut. Wir können behutsam weitermachen.",

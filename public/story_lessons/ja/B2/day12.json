 "scenes": [
  {
   "sceneId": "SC_B2_D12_OPEN",
   "kind": "narrative",
   "isLearningInput": false,
   "localizationMode": "arabic_ui_narration",
   "lines": [
    {
     "lineId": "N_B2_D12_01",
     "narrationArabic": "يتوسع المشروع ويحتاج كل فرد إلى دور محدد."
    }
   ]
  },
  {
   "sceneId": "SC_B2_D12_LEARN",
   "kind": "learning",
   "isLearningInput": true,
   "purposeArabic": "تفويض مهمة ومتابعة التزام.",
   "lines": [
    {
     "lineId": "L_B2_JA_D12_01",
     "speakerId": "elly",
     "targetText": "チームはチームの役割について懸念を抱いています。",
     "englishReference": "The team has concerns about the team roles.",
     "arabicTranslation": "لنناقش هذا الأمر بوضوح.",
     "pronunciation": "chiimu ha chiimu no yakuwari nitsuite kenen wo dai teimasu .",
     "phraseIds": [
      "P_B2_JA_D12_S01"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B2_JA_D12_02",
     "speakerId": "laith",
     "targetText": "私の立場は、各人は自分の役割を理解すべきだということです。",
     "englishReference": "My position is that each person should know their role.",
     "arabicTranslation": "موقفي هو أن الخيار يحتاج توازنًا.",
     "pronunciation": "watashi no tachiba ha , kakujin ha jibun no yakuwari wo rikai subekidatoiukotodesu .",
     "phraseIds": [
      "P_B2_JA_D12_C01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_JA_D12_03",
     "speakerId": "elly",
     "targetText": "リスクについて説明してもらえますか？",
     "englishReference": "Can you explain the risk?",
     "arabicTranslation": "ما الاعتراض الأقوى؟",
     "pronunciation": "risuku nitsuite setsumeishi temoraemasuka ？",
     "phraseIds": [
      "P_B2_JA_D12_I01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_JA_D12_04",
     "speakerId": "laith",
     "targetText": "リスクとしては、一部のタスクが重複することです。",
     "englishReference": "The risk is that some tasks overlap.",
     "arabicTranslation": "لأن علينا النظر إلى النتائج الواقعية.",
     "pronunciation": "risuku toshiteha , ichibu no tasuku ga choufuku surukotodesu .",
     "phraseIds": [
      "P_B2_JA_D12_C02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_JA_D12_05",
     "speakerId": "elly",
     "targetText": "どうすればそれを減らすことができるでしょうか？",
     "englishReference": "How can we reduce it?",
     "arabicTranslation": "ماذا تقترح؟",
     "pronunciation": "dousurebasorewo hera sukotogadekirudeshouka ？",
     "phraseIds": [
      "P_B2_JA_D12_I02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_JA_D12_06",
     "speakerId": "laith",
     "targetText": "一つの共有スケジュールを作ることができれば行動することができます。",
     "englishReference": "We can act if we can make one shared schedule.",
     "arabicTranslation": "يمكننا وضع شرط عادل وواضح.",
     "pronunciation": "hitotsu no kyouyuu sukejuuru wo tsukuru kotogadekireba koudou surukotogadekimasu .",
     "phraseIds": [
      "P_B2_JA_D12_C03"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_JA_D12_07",
     "speakerId": "elly",
     "targetText": "それは便利な条件です。",
     "englishReference": "That is a useful condition.",
     "arabicTranslation": "هذا يبدو متوازنًا.",
     "pronunciation": "soreha benri na jouken desu .",
     "phraseIds": [
      "P_B2_JA_D12_S02"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B2_JA_D12_08",
     "speakerId": "laith",
     "targetText": "ありがとう。チームと共有させていただきます。",
     "englishReference": "Thank you. I will share it with the team.",
     "arabicTranslation": "شكرًا، لنكتب الخطوة التالية.",
     "pronunciation": "arigatou . chiimu to kyouyuu saseteitadakimasu .",
     "phraseIds": [
      "P_B2_JA_D12_S03"
     ],
     "teachingExposure": "context"
    }
   ]
  },

 "scenes": [
  {
   "sceneId": "SC_B2_D05_OPEN",
   "kind": "narrative",
   "isLearningInput": false,
   "localizationMode": "arabic_ui_narration",
   "lines": [
    {
     "lineId": "N_B2_D05_01",
     "narrationArabic": "يعترض تاجر على شروط استخدام الطريق."
    }
   ]
  },
  {
   "sceneId": "SC_B2_D05_LEARN",
   "kind": "learning",
   "isLearningInput": true,
   "purposeArabic": "الرد على اعتراض باحترام.",
   "lines": [
    {
     "lineId": "L_B2_JA_D05_01",
     "speakerId": "merchant",
     "targetText": "道路状況を見直す必要がある。",
     "englishReference": "We need to review the road conditions.",
     "arabicTranslation": "لنناقش هذا الأمر بوضوح.",
     "pronunciation": "dourojoukyou wo minaosu hitsuyou gaaru .",
     "phraseIds": [
      "P_B2_JA_D05_S01"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B2_JA_D05_02",
     "speakerId": "laith",
     "targetText": "他の選択肢と比較すると、この条件により両方の村が保護されます。",
     "englishReference": "Compared with the other option, the conditions protect both villages.",
     "arabicTranslation": "موقفي هو أن الخيار يحتاج توازنًا.",
     "pronunciation": "hokano sentakushi to hikaku suruto , kono jouken niyori ryouhou no mura ga hogo saremasu .",
     "phraseIds": [
      "P_B2_JA_D05_C01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_JA_D05_03",
     "speakerId": "merchant",
     "targetText": "それがなぜ重要なのでしょうか?",
     "englishReference": "Why is that important?",
     "arabicTranslation": "ما الاعتراض الأقوى؟",
     "pronunciation": "soreganaze juuyouna nodeshouka ?",
     "phraseIds": [
      "P_B2_JA_D05_I01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_JA_D05_04",
     "speakerId": "laith",
     "targetText": "厳しそうに見えるかもしれないから。",
     "englishReference": "Because they may seem strict.",
     "arabicTranslation": "لأن علينا النظر إلى النتائج الواقعية.",
     "pronunciation": "ikameshiso uni mie rukamoshirenaikara .",
     "phraseIds": [
      "P_B2_JA_D05_C02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_JA_D05_05",
     "speakerId": "merchant",
     "targetText": "次に何が起こるべきでしょうか？",
     "englishReference": "What should happen next?",
     "arabicTranslation": "ماذا تقترح؟",
     "pronunciation": "tsugini nani ga oko rubekideshouka ？",
     "phraseIds": [
      "P_B2_JA_D05_I02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_JA_D05_06",
     "speakerId": "laith",
     "targetText": "1 か月後に見直してみることをお勧めします。",
     "englishReference": "I suggest that we can review them after one month.",
     "arabicTranslation": "يمكننا وضع شرط عادل وواضح.",
     "pronunciation": "1  ka getsugo ni minaoshi temirukotowoo susume shimasu .",
     "phraseIds": [
      "P_B2_JA_D05_C03"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B2_JA_D05_07",
     "speakerId": "merchant",
     "targetText": "あなたの立場は理解しています。",
     "englishReference": "I understand your position.",
     "arabicTranslation": "هذا يبدو متوازنًا.",
     "pronunciation": "anatano tachiba ha rikai shiteimasu .",
     "phraseIds": [
      "P_B2_JA_D05_S02"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B2_JA_D05_08",
     "speakerId": "laith",
     "targetText": "良い。慎重に続けていけます。",
     "englishReference": "Good. We can continue carefully.",
     "arabicTranslation": "شكرًا، لنكتب الخطوة التالية.",
     "pronunciation": "yoi . shinchou ni tsuzuke teikemasu .",
     "phraseIds": [
      "P_B2_JA_D05_S03"
     ],
     "teachingExposure": "context"
    }
   ]
  },

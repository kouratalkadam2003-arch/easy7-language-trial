   "lines": [
    {
     "lineId": "N_B1_D26_01",
     "narrationArabic": "يسأل فينسنت ليث عن العلامة التي وجدها في البلدة."
    }
   ]
  },
  {
   "sceneId": "SC_B1_D26_LEARN",
   "kind": "learning",
   "isLearningInput": true,
   "purposeArabic": "إدارة سؤال فضولي من دون كشف أسرار.",
   "lines": [
    {
     "lineId": "L_B1_JA_D26_01",
     "speakerId": "vincent",
     "targetText": "古いシンボルについて話さなければなりません。",
     "englishReference": "We need to talk about the old symbol.",
     "arabicTranslation": "نحتاج إلى الحديث عن the old symbol.",
     "pronunciation": "furui shinboru nitsuite hanasa nakerebanarimasen .",
     "phraseIds": [
      "P_B1_JA_D26_S01"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B1_JA_D26_02",
     "speakerId": "laith",
     "targetText": "私の意見では、私はまだそれを理解しようとしているところです。",
     "englishReference": "In my opinion, I am still trying to understand it.",
     "arabicTranslation": "في رأيي، I am still trying to understand it.",
     "pronunciation": "watashi no iken deha , watashi hamadasorewo rikai shiyoutoshiteirutokorodesu .",
     "phraseIds": [
      "P_B1_JA_D26_C01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_JA_D26_03",
     "speakerId": "vincent",
     "targetText": "なぜそう思いますか?",
     "englishReference": "Why do you think that?",
     "arabicTranslation": "لماذا تعتقد ذلك؟",
     "pronunciation": "nazesou omoi masuka ?",
     "phraseIds": [
      "P_B1_JA_D26_I01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_JA_D26_04",
     "speakerId": "laith",
     "targetText": "まだ十分な事実がわかっていないからです。",
     "englishReference": "Because I do not have enough facts yet.",
     "arabicTranslation": "لأن I do not have enough facts yet.",
     "pronunciation": "mada juubun na jijitsu gawakatteinaikaradesu .",
     "phraseIds": [
      "P_B1_JA_D26_C02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_JA_D26_05",
     "speakerId": "vincent",
     "targetText": "まず何をすべきでしょうか？",
     "englishReference": "What should we do first?",
     "arabicTranslation": "ماذا ينبغي أن نفعل أولًا؟",
     "pronunciation": "mazu naniwo subekideshouka ？",
     "phraseIds": [
      "P_B1_JA_D26_I02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_JA_D26_06",
     "speakerId": "laith",
     "targetText": "より良い証拠を待つべきだと私は提案します。",
     "englishReference": "I suggest that we should wait for better evidence.",
     "arabicTranslation": "أقترح أن we should wait for better evidence.",
     "pronunciation": "yori yoi shouko wo matsu bekidato watashi ha teian shimasu .",
     "phraseIds": [
      "P_B1_JA_D26_C03"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_JA_D26_07",
     "speakerId": "vincent",
     "targetText": "それは合理的だと思われます。",
     "englishReference": "That seems reasonable.",
     "arabicTranslation": "يبدو ذلك معقولًا.",
     "pronunciation": "soreha gouriteki dato omowa remasu .",
     "phraseIds": [
      "P_B1_JA_D26_S02"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B1_JA_D26_08",
     "speakerId": "laith",
     "targetText": "ありがとう。チームに説明してみます。",
     "englishReference": "Thank you. I will explain it to the team.",
     "arabicTranslation": "شكرًا. سأشرحه للفريق.",
     "pronunciation": "arigatou . chiimu ni setsumeishi temimasu .",
     "phraseIds": [
      "P_B1_JA_D26_S03"
     ],
     "teachingExposure": "context"
    }
   ]
  },

 "scenes": [
  {
   "sceneId": "SC_B1_D18_OPEN",
   "kind": "narrative",
   "isLearningInput": false,
   "localizationMode": "arabic_ui_narration",
   "lines": [
    {
     "lineId": "N_B1_D18_01",
     "narrationArabic": "يتحدث ليث مع مارثا بدل اتهامها أمام الناس."
    }
   ]
  },
  {
   "sceneId": "SC_B1_D18_LEARN",
   "kind": "learning",
   "isLearningInput": true,
   "purposeArabic": "طرح سؤال حساس باحترام.",
   "lines": [
    {
     "lineId": "L_B1_JA_D18_01",
     "speakerId": "martha",
     "targetText": "水の記録について話さなければなりません。",
     "englishReference": "We need to talk about the water records.",
     "arabicTranslation": "نحتاج إلى الحديث عن the water records.",
     "pronunciation": "mizu no kiroku nitsuite hanasa nakerebanarimasen .",
     "phraseIds": [
      "P_B1_JA_D18_S01"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B1_JA_D18_02",
     "speakerId": "laith",
     "targetText": "私の意見としては、何が起こったのかを理解したいと思っています。",
     "englishReference": "In my opinion, I want to understand what happened.",
     "arabicTranslation": "في رأيي، I want to understand what happened.",
     "pronunciation": "watashi no iken toshiteha , nani ga oko ttanokawo rikai shitaito omotte imasu .",
     "phraseIds": [
      "P_B1_JA_D18_C01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_JA_D18_03",
     "speakerId": "martha",
     "targetText": "なぜそう思いますか?",
     "englishReference": "Why do you think that?",
     "arabicTranslation": "لماذا تعتقد ذلك؟",
     "pronunciation": "nazesou omoi masuka ?",
     "phraseIds": [
      "P_B1_JA_D18_I01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_JA_D18_04",
     "speakerId": "laith",
     "targetText": "あなたを責めたくないからです。",
     "englishReference": "Because I do not want to accuse you.",
     "arabicTranslation": "لأن I do not want to accuse you.",
     "pronunciation": "anatawo seme takunaikaradesu .",
     "phraseIds": [
      "P_B1_JA_D18_C02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_JA_D18_05",
     "speakerId": "martha",
     "targetText": "まず何をすべきでしょうか？",
     "englishReference": "What should we do first?",
     "arabicTranslation": "ماذا ينبغي أن نفعل أولًا؟",
     "pronunciation": "mazu naniwo subekideshouka ？",
     "phraseIds": [
      "P_B1_JA_D18_I02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_JA_D18_06",
     "speakerId": "laith",
     "targetText": "一緒に記録を見てみようと思います。",
     "englishReference": "I suggest that we should look at the record together.",
     "arabicTranslation": "أقترح أن we should look at the record together.",
     "pronunciation": "isshoni kiroku wo mite miyouto omoi masu .",
     "phraseIds": [
      "P_B1_JA_D18_C03"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_JA_D18_07",
     "speakerId": "martha",
     "targetText": "それは合理的だと思われます。",
     "englishReference": "That seems reasonable.",
     "arabicTranslation": "يبدو ذلك معقولًا.",
     "pronunciation": "soreha gouriteki dato omowa remasu .",
     "phraseIds": [
      "P_B1_JA_D18_S02"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B1_JA_D18_08",
     "speakerId": "laith",
     "targetText": "ありがとう。チームに説明してみます。",
     "englishReference": "Thank you. I will explain it to the team.",
     "arabicTranslation": "شكرًا. سأشرحه للفريق.",
     "pronunciation": "arigatou . chiimu ni setsumeishi temimasu .",
     "phraseIds": [
      "P_B1_JA_D18_S03"
     ],
     "teachingExposure": "context"
    }
   ]
  },

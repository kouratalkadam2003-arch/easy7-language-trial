  },
  {
   "sceneId": "SC_B1_D12_LEARN",
   "kind": "learning",
   "isLearningInput": true,
   "purposeArabic": "توزيع مهام وتأكيد فهم الخطة.",
   "lines": [
    {
     "lineId": "L_B1_JA_D12_01",
     "speakerId": "team",
     "targetText": "修復作業について話し合う必要があります。",
     "englishReference": "We need to talk about the repair tasks.",
     "arabicTranslation": "نحتاج إلى الحديث عن the repair tasks.",
     "pronunciation": "shuufukusagyou nitsuite hanashiau hitsuyou gaarimasu .",
     "phraseIds": [
      "P_B1_JA_D12_S01"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B1_JA_D12_02",
     "speakerId": "laith",
     "targetText": "私の意見では、各人には 1 つの明確なタスクが必要です。",
     "englishReference": "In my opinion, each person needs one clear task.",
     "arabicTranslation": "في رأيي، each person needs one clear task.",
     "pronunciation": "watashi no iken deha , kakujin niha  1  tsuno meikaku na tasuku ga hitsuyou desu .",
     "phraseIds": [
      "P_B1_JA_D12_C01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_JA_D12_03",
     "speakerId": "team",
     "targetText": "なぜそう思いますか?",
     "englishReference": "Why do you think that?",
     "arabicTranslation": "لماذا تعتقد ذلك؟",
     "pronunciation": "nazesou omoi masuka ?",
     "phraseIds": [
      "P_B1_JA_D12_I01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_JA_D12_04",
     "speakerId": "laith",
     "targetText": "役割が明確であれば混乱を防ぐことができるからです。",
     "englishReference": "Because clear roles prevent confusion.",
     "arabicTranslation": "لأن clear roles prevent confusion.",
     "pronunciation": "yakuwari ga meikaku deareba konran wo fusegu kotogadekirukaradesu .",
     "phraseIds": [
      "P_B1_JA_D12_C02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_JA_D12_05",
     "speakerId": "team",
     "targetText": "まず何をすべきでしょうか？",
     "englishReference": "What should we do first?",
     "arabicTranslation": "ماذا ينبغي أن نفعل أولًا؟",
     "pronunciation": "mazu naniwo subekideshouka ？",
     "phraseIds": [
      "P_B1_JA_D12_I02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_JA_D12_06",
     "speakerId": "laith",
     "targetText": "正午に進捗状況を確認することをお勧めします。",
     "englishReference": "I suggest that we should check progress at noon.",
     "arabicTranslation": "أقترح أن we should check progress at noon.",
     "pronunciation": "shougo ni shinchokujoukyou wo kakuninsu rukotowoo susume shimasu .",
     "phraseIds": [
      "P_B1_JA_D12_C03"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_JA_D12_07",
     "speakerId": "team",
     "targetText": "それは合理的だと思われます。",
     "englishReference": "That seems reasonable.",
     "arabicTranslation": "يبدو ذلك معقولًا.",
     "pronunciation": "soreha gouriteki dato omowa remasu .",
     "phraseIds": [
      "P_B1_JA_D12_S02"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B1_JA_D12_08",
     "speakerId": "laith",
     "targetText": "ありがとう。チームに説明してみます。",
     "englishReference": "Thank you. I will explain it to the team.",
     "arabicTranslation": "شكرًا. سأشرحه للفريق.",
     "pronunciation": "arigatou . chiimu ni setsumeishi temimasu .",
     "phraseIds": [
      "P_B1_JA_D12_S03"
     ],
     "teachingExposure": "context"
    }
   ]
  },

   ]
  },
  {
   "sceneId": "SC_B1_D05_LEARN",
   "kind": "learning",
   "isLearningInput": true,
   "purposeArabic": "تقديم اقتراح عملي وشرحه.",
   "lines": [
    {
     "lineId": "L_B1_JA_D05_01",
     "speakerId": "elly",
     "targetText": "毎週のボードについて話し合う必要があります。",
     "englishReference": "We need to talk about a weekly board.",
     "arabicTranslation": "نحتاج إلى الحديث عن a weekly board.",
     "pronunciation": "maishuu no boodo nitsuite hanashiau hitsuyou gaarimasu .",
     "phraseIds": [
      "P_B1_JA_D05_S01"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B1_JA_D05_02",
     "speakerId": "laith",
     "targetText": "私の意見では、シンプルなウィークリーボードをお勧めします。",
     "englishReference": "In my opinion, I suggest a simple weekly board.",
     "arabicTranslation": "في رأيي، I suggest a simple weekly board.",
     "pronunciation": "watashi no iken deha , shinpuru na uiikuriiboodo woo susume shimasu .",
     "phraseIds": [
      "P_B1_JA_D05_C01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_JA_D05_03",
     "speakerId": "elly",
     "targetText": "なぜそう思いますか?",
     "englishReference": "Why do you think that?",
     "arabicTranslation": "لماذا تعتقد ذلك؟",
     "pronunciation": "nazesou omoi masuka ?",
     "phraseIds": [
      "P_B1_JA_D05_I01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_JA_D05_04",
     "speakerId": "laith",
     "targetText": "それは計画が見えるようになるからです。",
     "englishReference": "Because it makes the plan visible.",
     "arabicTranslation": "لأن it makes the plan visible.",
     "pronunciation": "soreha keikaku ga mie ruyouninarukaradesu .",
     "phraseIds": [
      "P_B1_JA_D05_C02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_JA_D05_05",
     "speakerId": "elly",
     "targetText": "まず何をすべきでしょうか？",
     "englishReference": "What should we do first?",
     "arabicTranslation": "ماذا ينبغي أن نفعل أولًا؟",
     "pronunciation": "mazu naniwo subekideshouka ？",
     "phraseIds": [
      "P_B1_JA_D05_I02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_JA_D05_06",
     "speakerId": "laith",
     "targetText": "1週間テストしてみることをお勧めします。",
     "englishReference": "I suggest that we should test it for one week.",
     "arabicTranslation": "أقترح أن we should test it for one week.",
     "pronunciation": "1 shuukan tesuto shitemirukotowoo susume shimasu .",
     "phraseIds": [
      "P_B1_JA_D05_C03"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_B1_JA_D05_07",
     "speakerId": "elly",
     "targetText": "それは合理的だと思われます。",
     "englishReference": "That seems reasonable.",
     "arabicTranslation": "يبدو ذلك معقولًا.",
     "pronunciation": "soreha gouriteki dato omowa remasu .",
     "phraseIds": [
      "P_B1_JA_D05_S02"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_B1_JA_D05_08",
     "speakerId": "laith",
     "targetText": "ありがとう。チームに説明してみます。",
     "englishReference": "Thank you. I will explain it to the team.",
     "arabicTranslation": "شكرًا. سأشرحه للفريق.",
     "pronunciation": "arigatou . chiimu ni setsumeishi temimasu .",
     "phraseIds": [
      "P_B1_JA_D05_S03"
     ],
     "teachingExposure": "context"
    }
   ]
  },

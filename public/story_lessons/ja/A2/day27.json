  {
   "sceneId": "SC_A2_D27_LEARNING",
   "kind": "learning",
   "isLearningInput": true,
   "purposeArabic": "الحديث عن شراء وبيع ووصف منتجات.",
   "lines": [
    {
     "lineId": "L_A2_JA_D27_01",
     "speakerId": "visitor",
     "targetText": "おはようございます、ライスさん。これらの野菜はどこから来たのですか?",
     "englishReference": "Good morning, Laith. Where do these vegetables come from?",
     "arabicTranslation": "صباح الخير يا ليث. Where do these vegetables come from?",
     "pronunciation": "ohayougozaimasu , raisu san . korerano yasai hadokokara kita nodesuka ?",
     "phraseIds": [
      "P_A2_JA_D27_S01"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_A2_JA_D27_02",
     "speakerId": "laith",
     "targetText": "おはよう。彼らは私たちの村の庭から来ています。",
     "englishReference": "Good morning. They come from our village garden.",
     "arabicTranslation": "صباح الخير. They come from our village garden.",
     "pronunciation": "ohayou . karera ha watashitachi no mura no niwa kara kite imasu .",
     "phraseIds": [
      "P_A2_JA_D27_C01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_A2_JA_D27_03",
     "speakerId": "visitor",
     "targetText": "かごを2つ購入できますか?",
     "englishReference": "Can I buy two baskets?",
     "arabicTranslation": "Can I buy two baskets?",
     "pronunciation": "kagowo 2 tsu kounyuu dekimasuka ?",
     "phraseIds": [
      "P_A2_JA_D27_I01"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_A2_JA_D27_04",
     "speakerId": "laith",
     "targetText": "はい、もちろん。今日は新鮮です。",
     "englishReference": "Yes, of course. They are fresh today.",
     "arabicTranslation": "Yes, of course. They are fresh today.",
     "pronunciation": "hai , mochiron . konnichiha shinsen desu .",
     "phraseIds": [
      "P_A2_JA_D27_C02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_A2_JA_D27_05",
     "speakerId": "visitor",
     "targetText": "いくらですか?",
     "englishReference": "How much are they?",
     "arabicTranslation": "How much are they?",
     "pronunciation": "ikuradesuka ?",
     "phraseIds": [
      "P_A2_JA_D27_I02"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_A2_JA_D27_06",
     "speakerId": "laith",
     "targetText": "それぞれ4枚のコインです。",
     "englishReference": "They are four coins each.",
     "arabicTranslation": "They are four coins each.",
     "pronunciation": "sorezore 4 mai no koin desu .",
     "phraseIds": [
      "P_A2_JA_D27_C03"
     ],
     "teachingExposure": "new"
    },
    {
     "lineId": "L_A2_JA_D27_07",
     "speakerId": "visitor",
     "targetText": "それは良い計画のように思えます。",
     "englishReference": "That sounds like a good plan.",
     "arabicTranslation": "تبدو هذه خطة جيدة.",
     "pronunciation": "soreha yoi keikaku noyouni omoe masu .",
     "phraseIds": [
      "P_A2_JA_D27_S02"
     ],
     "teachingExposure": "context"
    },
    {
     "lineId": "L_A2_JA_D27_08",
     "speakerId": "laith",
     "targetText": "ありがとう。また後で。",
     "englishReference": "Thank you. See you later.",
     "arabicTranslation": "شكرًا لك. أراك لاحقًا.",
     "pronunciation": "arigatou . mata atode .",
     "phraseIds": [
      "P_A2_JA_D27_S03"
     ],
     "teachingExposure": "context"
    }
   ]
  },
